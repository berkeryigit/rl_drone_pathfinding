# RL drone pathfinding — CPU / GPU'SUZ image (MacBook + Ubuntu 24.04 VM icin).
# Mevcut Dockerfile NVIDIA/x86'a ozeldi (CUDA 12.1 + runtime:nvidia); bu varyant:
#   * GPU YOK -> CPU torch (CUDA extra-index KALDIRILDI; pip arch'a gore CPU wheel secer)
#   * Yazilim render (Gazebo gpu_lidar GPU'suz VM'de mesa/llvmpipe + xvfb ile calisir)
#   * Cok mimarili: osrf/ros:jazzy-desktop hem amd64 hem arm64 (Apple Silicon VM) destekler
FROM osrf/ros:jazzy-desktop

ARG DEBIAN_FRONTEND=noninteractive
ARG USERNAME=dev
ARG USER_UID=1000
ARG USER_GID=1000

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl git wget sudo nano less tmux \
        python3-pip python3-venv python3-colcon-common-extensions \
        python3-rosdep python3-vcstool \
        ros-jazzy-ros-gz ros-jazzy-ros-gz-bridge ros-jazzy-ros-gz-sim \
        ros-jazzy-rmw-cyclonedds-cpp \
        gz-harmonic \
        mesa-utils libglu1-mesa libgl1-mesa-dri libglx-mesa0 xvfb \
    && rm -rf /var/lib/apt/lists/*

# CPU torch + ML stack — CUDA extra-index YOK; pip her mimaride dogru CPU wheel'i ceker.
COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r /tmp/requirements.txt || \
    echo "UYARI: requirements pin'i bu mimaride bulunamadi olabilir; torch'u elle kur: pip3 install torch --break-system-packages"

RUN groupadd --gid ${USER_GID} ${USERNAME} 2>/dev/null || true \
    && useradd --uid ${USER_UID} --gid ${USER_GID} -m -s /bin/bash ${USERNAME} 2>/dev/null || true \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
    && mkdir -p /workspace && chown ${USER_UID}:${USER_GID} /workspace

USER ${USERNAME}
WORKDIR /workspace

# GPU yok -> yazilim GL. Egitim headless (GUI yok). gz transport loopback (freeze fix).
ENV LIBGL_ALWAYS_SOFTWARE=1 \
    GALLIUM_DRIVER=llvmpipe \
    SIM_HEADLESS=1 \
    GZ_IP=127.0.0.1 \
    IGN_IP=127.0.0.1 \
    ROS_DOMAIN_ID=42 \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

RUN echo 'source /opt/ros/jazzy/setup.bash' >> ~/.bashrc \
    && echo '[ -f /workspace/ros2_ws/install/setup.bash ] && source /workspace/ros2_ws/install/setup.bash' >> ~/.bashrc \
    && echo 'export LIBGL_ALWAYS_SOFTWARE=1 GZ_IP=127.0.0.1' >> ~/.bashrc
