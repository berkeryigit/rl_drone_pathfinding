<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="multi_room">

    <physics name="fast" type="ignored">
      <max_step_size>0.02</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"       name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"  name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"       name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"           name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"       name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.81</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         Tek katli, 16x16 m, 2.5 m yuksek bina.
         6 oda — ASIMETRIK boyutlar ve farkli kapi konumlari:

           R3 (6x8)  |  R4 (6x8)  |  R5 (4x8)
           ──────────┼────────────┼───────────
           R0 (6x8)  |  R1 (6x8)  |  R2 (4x8)

         Sol dikey duvar x=-2 : kapi y in [-4,-2]  (alt kisim)
         Sag dikey duvar x= 4 : kapi y in [ 3, 5]  (ust kisim)
         Yatay duvar    y= 0  : kapilar x in [-7,-5], [0,2], [5,7]

         Kapi konumlari kasitli olarak farkli — drone her odaya
         farkli yonden girmek zorunda.
    ================================================================ -->

    <model name="building">
      <static>true</static>

      <!-- Dis duvarlar -->
      <link name="wall_n">
        <pose>0 8 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>16.4 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16.4 0.2 3</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
      </link>
      <link name="wall_s">
        <pose>0 -8 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>16.4 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16.4 0.2 3</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
      </link>
      <link name="wall_w">
        <pose>-8 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 16 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 16 3</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
      </link>
      <link name="wall_e">
        <pose>8 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 16 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 16 3</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
      </link>

      <!-- Tavan -->
      <link name="roof">
        <pose>0 0 2.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>16 16 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16 16 0.1</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>

      <!-- Sol dikey duvar (x=-2), kapi y in [-5,-1] (4m genis) — arttirildi -->
      <link name="lwall_bot">
        <pose>-2 -6.5 1.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 3.0 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 3.0 2.3</size></box></geometry>
          <material><ambient>0.5 0.5 0.65 1</ambient><diffuse>0.55 0.55 0.7 1</diffuse></material></visual>
      </link>
      <link name="lwall_top">
        <pose>-2 3.5 1.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 9.0 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 9.0 2.3</size></box></geometry>
          <material><ambient>0.5 0.5 0.65 1</ambient><diffuse>0.55 0.55 0.7 1</diffuse></material></visual>
      </link>

      <!-- Sag dikey duvar (x=4), kapi y in [2,6] (4m genis) — arttirildi -->
      <link name="rwall_bot">
        <pose>4 -3 1.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 10.0 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 10.0 2.3</size></box></geometry>
          <material><ambient>0.5 0.5 0.65 1</ambient><diffuse>0.55 0.55 0.7 1</diffuse></material></visual>
      </link>
      <link name="rwall_top">
        <pose>4 7 1.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 2.0 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.0 2.3</size></box></geometry>
          <material><ambient>0.5 0.5 0.65 1</ambient><diffuse>0.55 0.55 0.7 1</diffuse></material></visual>
      </link>

      <!-- Yatay duvar (y=0), 4m'lik kapilar (arttirildi 3m'den) —
           Kapi 1: x in [-8, -4]   (4m)
           Duvar:  x in [-4, -2]   (2m)
           Kapi 2: x in [-2, 2]    (4m)
           Duvar:  x in [2, 4]     (2m)
           Kapi 3: x in [4, 8]     (4m) -->
      <link name="hwall_1">
        <pose>-6 0 1.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.01 0.2 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.01 0.2 2.3</size></box></geometry>
          <material><ambient>0.5 0.5 0.65 1</ambient><diffuse>0.55 0.55 0.7 1</diffuse></material></visual>
      </link>
      <link name="hwall_2">
        <pose>-3 0 1.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.0 0.2 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 0.2 2.3</size></box></geometry>
          <material><ambient>0.5 0.5 0.65 1</ambient><diffuse>0.55 0.55 0.7 1</diffuse></material></visual>
      </link>
      <link name="hwall_3">
        <pose>0 0 1.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.01 0.2 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.01 0.2 2.3</size></box></geometry>
          <material><ambient>0.5 0.5 0.65 1</ambient><diffuse>0.55 0.55 0.7 1</diffuse></material></visual>
      </link>
      <link name="hwall_4">
        <pose>3 0 1.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.0 0.2 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 0.2 2.3</size></box></geometry>
          <material><ambient>0.5 0.5 0.65 1</ambient><diffuse>0.55 0.55 0.7 1</diffuse></material></visual>
      </link>
      <link name="hwall_5">
        <pose>6 0 1.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.01 0.2 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.01 0.2 2.3</size></box></geometry>
          <material><ambient>0.5 0.5 0.65 1</ambient><diffuse>0.55 0.55 0.7 1</diffuse></material></visual>
      </link>
      <link name="hwall_6">
        <pose>7 0 1.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.01 0.2 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.01 0.2 2.3</size></box></geometry>
          <material><ambient>0.5 0.5 0.65 1</ambient><diffuse>0.55 0.55 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Hareketli engeller — Python env tarafindan gz service ile tasinir -->
    <!-- Tum engeller z=1.25 merkezli, 2.5m yuksek — drone her irtifada carpar -->
    <!-- R0 icinde, y yonunde salinar -->
    <model name="obs_moving_1">
      <static>true</static>
      <pose>-5.0 -3.0 1.25 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.85 0.2 0.2 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- R4 icinde, x yonunde salinar -->
    <model name="obs_moving_2">
      <static>true</static>
      <pose>1.0 4.0 1.25 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.7 0.7 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.7 0.7 2.5</size></box></geometry>
          <material><ambient>0.2 0.7 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- R2 icinde, y yonunde salinar -->
    <model name="obs_moving_3">
      <static>true</static>
      <pose>6.0 -4.0 1.25 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.85 0.2 0.2 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
