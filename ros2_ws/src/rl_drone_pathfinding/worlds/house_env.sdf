<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="house_env">
    <physics name="1ms" type="ignored">
      <max_step_size>0.02</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Lidar sensörü için -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Isiklar -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Zemin (Ground) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- EV DUVARLARI VE ODALAR (12x12 m alan) -->
    <!-- Dis Duvarlar (Outer Walls) -->
    <model name="outer_walls">
      <static>true</static>
      <!-- Kuzey Duvar -->
      <link name="north_wall">
        <pose>0 6 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>12 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12 0.2 3</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
      <!-- Guney Duvar -->
      <link name="south_wall">
        <pose>0 -6 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>12 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12 0.2 3</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
      <!-- Bati Duvar -->
      <link name="west_wall">
        <pose>-6 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 12 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 12 3</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
      <!-- Dogu Duvar -->
      <link name="east_wall">
        <pose>6 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 12 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 12 3</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>

      <!-- IC DUVARLAR (Cross shape, dividing into 4 rooms) -->
      <!-- Vertical divider (Y ekseninde) Kapı boşluklu -->
      <link name="mid_v1">
        <pose>0 3.5 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 4.8 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 4.8 3</size></box></geometry><material><ambient>0.6 0.6 0.8 1</ambient></material></visual>
      </link>
      <link name="mid_v2">
        <pose>0 -3.5 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 4.8 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 4.8 3</size></box></geometry><material><ambient>0.6 0.6 0.8 1</ambient></material></visual>
      </link>

      <!-- Horizontal divider (X ekseninde) Kapı boşluklu -->
      <link name="mid_h1">
        <pose>3.5 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>4.8 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.8 0.2 3</size></box></geometry><material><ambient>0.6 0.6 0.8 1</ambient></material></visual>
      </link>
      <link name="mid_h2">
        <pose>-3.5 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>4.8 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.8 0.2 3</size></box></geometry><material><ambient>0.6 0.6 0.8 1</ambient></material></visual>
      </link>
    </model>

    <!-- SABIT ENGELLER (Mobilyalar) -->
    <!-- Salon (Kuzey-Bati odasi): Koltuk -->
    <model name="sofa_static">
      <static>true</static>
      <pose>-3 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2 1 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2 1 1</size></box></geometry>
          <material><ambient>0.2 0.8 0.2 1</ambient></material> <!-- Yesil Koltuk -->
        </visual>
      </link>
    </model>

    <!-- Mutfak (Kuzey-Dogu odasi): Mutfak Adasi -->
    <model name="kitchen_island_static">
      <static>true</static>
      <pose>3 3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 2 1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.5 2 1</size></box></geometry>
          <material><ambient>0.5 0.3 0.1 1</ambient></material> <!-- Kahverengi Ada -->
        </visual>
      </link>
    </model>

    <!-- Yatak Odasi (Guney-Bati odasi): Yatak -->
    <model name="bed_static">
      <static>true</static>
      <pose>-4 -4 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2 2 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2 2 0.8</size></box></geometry>
          <material><ambient>0.1 0.1 0.8 1</ambient></material> <!-- Mavi Yatak -->
        </visual>
      </link>
    </model>

    <!-- HAREKETLI ENGEL (Robot Supurge / Evcil Hayvan) -->
    <!-- Bu obje salon ve mutfak kapisi arasinda surekli gidip gelecek -->
    <model name="moving_pet">
      <static>false</static>
      <pose>0 0.5 0.3 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.4</radius><length>0.6</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.4</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material> <!-- Kirmizi Hareketli Silindir -->
        </visual>
      </link>
      <!-- Trajectory plugin for movement -->
      <plugin filename="gz-sim-trajectory-system" name="gz::sim::systems::Trajectory">
        <link_name>link</link_name>
        <loop>true</loop>
        <trajectory>
          <waypoint>
            <time>0.0</time>
            <pose>-2 0.5 0.3 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>4.0</time>
            <pose>2 0.5 0.3 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>8.0</time>
            <pose>-2 0.5 0.3 0 0 0</pose>
          </waypoint>
        </trajectory>
      </plugin>
    </model>

  </world>
</sdf>
