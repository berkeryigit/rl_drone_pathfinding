<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="multi_room">

    <physics name="fast" type="ignored">
      <max_step_size>0.02</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.81</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- 6-room building. 1 storey. Total area: 24x16 m (x: -8 to 16, y: -8 to 8). -->
    <!-- Rooms are 8x8m. Centers at (-4, 4), (4, 4), (12, 4), (-4, -4), (4, -4), (12, -4). -->
    <!-- ============================================================== -->
    <model name="building">
      <static>true</static>

      <!-- ===== Outer walls ===== -->
      <link name="wall_n">
        <pose>4 8 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>24 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>24 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
      <link name="wall_s">
        <pose>4 -8 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>24 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>24 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
      <link name="wall_w">
        <pose>-8 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 16 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 16 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
      <link name="wall_e">
        <pose>16 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 16 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 16 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>

      <!-- ===== Roof ===== -->
      <link name="roof">
        <pose>4 0 3.0 0 0 0</pose>
        <collision name="c"><geometry><box><size>24 16 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>24 16 0.1</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>

      <!-- ===== Inner horizontal walls (y=0) ===== -->
      <link name="wall_h_1_l">
        <pose>-6.75 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.5 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.5 0.2 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="wall_h_1_r">
        <pose>-1.25 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.5 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.5 0.2 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      
      <link name="wall_h_2_l">
        <pose>1.25 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.5 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.5 0.2 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="wall_h_2_r">
        <pose>6.75 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.5 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.5 0.2 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>

      <link name="wall_h_3_l">
        <pose>9.25 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.5 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.5 0.2 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="wall_h_3_r">
        <pose>14.75 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.5 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.5 0.2 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>

      <!-- ===== Inner vertical walls (x=0) ===== -->
      <link name="wall_v_1_b">
        <pose>0 -6.75 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 2.5 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.5 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="wall_v_1_t">
        <pose>0 -1.25 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 2.5 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.5 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="wall_v_2_b">
        <pose>0 1.25 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 2.5 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.5 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="wall_v_2_t">
        <pose>0 6.75 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 2.5 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.5 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>

      <!-- ===== Inner vertical walls (x=8) ===== -->
      <link name="wall_v_3_b">
        <pose>8 -6.75 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 2.5 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.5 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="wall_v_3_t">
        <pose>8 -1.25 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 2.5 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.5 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="wall_v_4_b">
        <pose>8 1.25 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 2.5 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.5 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="wall_v_4_t">
        <pose>8 6.75 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 2.5 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.5 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ====== 6 Obstacles (1 per room) ====== -->
    <model name="obs_1">
      <static>true</static>
      <pose>-2.5 5.5 1 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.5</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.5</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.2 1</ambient><diffuse>0.5 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obs_2">
      <static>true</static>
      <pose>5.5 5.5 1 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.5</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.5</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.2 1</ambient><diffuse>0.5 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obs_3">
      <static>true</static>
      <pose>13.5 5.5 1 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.5</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.5</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.2 1</ambient><diffuse>0.5 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obs_4">
      <static>true</static>
      <pose>-2.5 -2.5 1 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.5</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.5</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.2 1</ambient><diffuse>0.5 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obs_5">
      <static>true</static>
      <pose>5.5 -2.5 1 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.5</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.5</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.2 1</ambient><diffuse>0.5 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obs_6">
      <static>true</static>
      <pose>13.5 -2.5 1 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.5</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.5</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.2 1</ambient><diffuse>0.5 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
