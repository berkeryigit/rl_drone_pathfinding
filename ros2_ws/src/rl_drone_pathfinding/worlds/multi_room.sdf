<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="multi_room">

    <!-- Aggressive training-time physics:
         * max_step_size 0.02 = 4x fewer integrator steps. Above ~0.05 a fast
           drone can tunnel through walls (single step > collision margin), so
           0.02 is roughly the upper bound here.
         * real_time_factor 0 = run as fast as the host can.
         Combined with headless gz (-s) this typically yields 30-50x wall-clock
         speedup against real-time on this box. -->
    <physics name="fast" type="ignored">
      <max_step_size>0.02</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.81</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- 3-storey building. Each floor is 16x16 m, 2.5 m tall.          -->
    <!-- Total height: 7.5 m. Outer walls span the full height.         -->
    <!-- Floor 0 -> 1 hole: NE quadrant, 3.5..6.5 in x, 3.5..6.5 in y.  -->
    <!-- Floor 1 -> 2 hole: SW quadrant, -6.5..-3.5 in x, -6.5..-3.5 y. -->
    <!-- (3 m x 3 m holes; enlarged from 2x2 so the agent can find them -->
    <!--  during random exploration.)                                    -->
    <!-- Internal walls per floor: vertical at x=0 and horizontal at    -->
    <!-- y=0, each with a 2 m door gap centered at the origin.          -->
    <!-- ============================================================== -->
    <model name="building">
      <static>true</static>

      <!-- ===== Outer walls, full 8 m height (slightly taller than 7.5 m) ===== -->
      <link name="wall_n">
        <pose>0 8 4 0 0 0</pose>
        <collision name="c"><geometry><box><size>16 0.2 8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16 0.2 8</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
      <link name="wall_s">
        <pose>0 -8 4 0 0 0</pose>
        <collision name="c"><geometry><box><size>16 0.2 8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16 0.2 8</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
      <link name="wall_w">
        <pose>-8 0 4 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 16 8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 16 8</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
      <link name="wall_e">
        <pose>8 0 4 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 16 8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 16 8</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>

      <!-- ============== Floor 1 (z = 2.5), hole at NE 3.5..6.5, 3.5..6.5 ============== -->
      <!-- left big slab: x in [-8, 3.5] -->
      <link name="floor1_left">
        <pose>-2.25 0 2.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>11.5 16 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>11.5 16 0.1</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
      <!-- right thin slab: x in [6.5, 8] -->
      <link name="floor1_right">
        <pose>7.25 0 2.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.5 16 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 16 0.1</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
      <!-- mid south of hole: x in [3.5, 6.5], y in [-8, 3.5] -->
      <link name="floor1_mid_s">
        <pose>5 -2.25 2.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>3 11.5 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3 11.5 0.1</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
      <!-- mid north of hole: x in [3.5, 6.5], y in [6.5, 8] -->
      <link name="floor1_mid_n">
        <pose>5 7.25 2.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>3 1.5 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3 1.5 0.1</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>

      <!-- ============== Floor 2 (z = 5.0), hole at SW -6.5..-3.5, -6.5..-3.5 ============== -->
      <!-- right big slab: x in [-3.5, 8] -->
      <link name="floor2_right">
        <pose>2.25 0 5.0 0 0 0</pose>
        <collision name="c"><geometry><box><size>11.5 16 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>11.5 16 0.1</size></box></geometry>
          <material><ambient>0.5 0.5 0.6 1</ambient><diffuse>0.55 0.55 0.65 1</diffuse></material></visual>
      </link>
      <!-- left thin slab: x in [-8, -6.5] -->
      <link name="floor2_left">
        <pose>-7.25 0 5.0 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.5 16 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 16 0.1</size></box></geometry>
          <material><ambient>0.5 0.5 0.6 1</ambient><diffuse>0.55 0.55 0.65 1</diffuse></material></visual>
      </link>
      <!-- mid south of hole: x in [-6.5, -3.5], y in [-8, -6.5] -->
      <link name="floor2_mid_s">
        <pose>-5 -7.25 5.0 0 0 0</pose>
        <collision name="c"><geometry><box><size>3 1.5 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3 1.5 0.1</size></box></geometry>
          <material><ambient>0.5 0.5 0.6 1</ambient><diffuse>0.55 0.55 0.65 1</diffuse></material></visual>
      </link>
      <!-- mid north of hole: x in [-6.5, -3.5], y in [-3.5, 8] -->
      <link name="floor2_mid_n">
        <pose>-5 2.25 5.0 0 0 0</pose>
        <collision name="c"><geometry><box><size>3 11.5 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3 11.5 0.1</size></box></geometry>
          <material><ambient>0.5 0.5 0.6 1</ambient><diffuse>0.55 0.55 0.65 1</diffuse></material></visual>
      </link>

      <!-- ============== Roof (z = 7.5), full slab ============== -->
      <link name="roof">
        <pose>0 0 7.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>16 16 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16 16 0.1</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>

      <!-- ============== Internal walls — repeated per floor, 2.3 m tall ============== -->
      <!-- Floor 0 (center z = 1.15) -->
      <link name="f0_wall_v_top">
        <pose>0 4.5 1.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 7 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 7 2.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="f0_wall_v_bot">
        <pose>0 -4.5 1.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 7 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 7 2.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="f0_wall_h_left">
        <pose>-4.5 0 1.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>7 0.2 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7 0.2 2.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="f0_wall_h_right">
        <pose>4.5 0 1.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>7 0.2 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7 0.2 2.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>

      <!-- Floor 1 (center z = 3.65) -->
      <link name="f1_wall_v_top">
        <pose>0 4.5 3.65 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 7 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 7 2.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="f1_wall_v_bot">
        <pose>0 -4.5 3.65 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 7 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 7 2.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="f1_wall_h_left">
        <pose>-4.5 0 3.65 0 0 0</pose>
        <collision name="c"><geometry><box><size>7 0.2 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7 0.2 2.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="f1_wall_h_right">
        <pose>4.5 0 3.65 0 0 0</pose>
        <collision name="c"><geometry><box><size>7 0.2 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7 0.2 2.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>

      <!-- Floor 2 (center z = 6.15) -->
      <link name="f2_wall_v_top">
        <pose>0 4.5 6.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 7 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 7 2.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="f2_wall_v_bot">
        <pose>0 -4.5 6.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 7 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 7 2.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="f2_wall_h_left">
        <pose>-4.5 0 6.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>7 0.2 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7 0.2 2.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
      <link name="f2_wall_h_right">
        <pose>4.5 0 6.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>7 0.2 2.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7 0.2 2.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ====== A few obstacles, distributed across floors ====== -->
    <model name="obs_pillar_f0_1">
      <static>true</static>
      <pose>4 5 0.5 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.2 1</ambient><diffuse>0.5 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obs_pillar_f0_2">
      <static>true</static>
      <pose>-5 -3 0.5 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.2 1</ambient><diffuse>0.5 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obs_box_f1_1">
      <static>true</static>
      <pose>-3 3 3.0 0 0 0.7</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><ambient>0.2 0.3 0.4 1</ambient><diffuse>0.2 0.3 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obs_box_f1_2">
      <static>true</static>
      <pose>5 -5 3.0 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><ambient>0.2 0.3 0.4 1</ambient><diffuse>0.2 0.3 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obs_pillar_f2_1">
      <static>true</static>
      <pose>3 -4 5.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.2 1</ambient><diffuse>0.5 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
