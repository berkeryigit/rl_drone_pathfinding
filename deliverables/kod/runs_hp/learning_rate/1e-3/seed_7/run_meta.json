{
  "seed": 7,
  "algo": "PPO",
  "total_timesteps": 200000,
  "resume": null,
  "num_envs": 8,
  "device": "cpu",
  "ppo": {
    "policy": "MlpPolicy",
    "learning_rate": 0.001,
    "n_steps": 1024,
    "batch_size": 512,
    "n_epochs": 10,
    "gamma": 0.98,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "ent_coef": 0.005,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "use_sde": false,
    "net_arch": [
      256,
      256
    ]
  },
  "env": {
    "max_episode_steps": 600,
    "random_start": true,
    "lidar_noise_std": 0.015,
    "odom_noise_std": 0.004,
    "wind_std": 0.015
  }
}